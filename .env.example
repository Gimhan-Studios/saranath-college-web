# Application environment ("development" or "production")
NODE_ENV=development
PORT=3000

# Random secret for signing session/CSRF tokens and IP fingerprints
SECRET_KEY=

# 32-byte base64 key or passphrase for encrypting private feedback at rest
DATA_ENCRYPTION_KEY=

# Optional initial superadmin account seeded on startup (min 12 chars, letters + numbers)
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Site Administrator
